# Exchange credentials (fill in for live trading; leave blank for paper trading)
EXCHANGE=binance
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Trading mode: paper | live
TRADING_MODE=paper

# Symbol and timeframe
SYMBOL=BTC/USDT
TIMEFRAME=1h

# Strategy parameters
STRATEGY=sma_crossover
SMA_FAST=10
SMA_SLOW=30

# Risk management
MAX_POSITION_PCT=0.10   # max 10% of portfolio per trade
STOP_LOSS_PCT=0.02      # 2% stop-loss
TAKE_PROFIT_PCT=0.04    # 4% take-profit

# Paper trading starting balance (USDT)
PAPER_BALANCE=10000
