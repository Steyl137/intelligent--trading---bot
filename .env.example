# ============================================================
# Broker selection
# ============================================================
# "ccxt"  – use a ccxt-supported exchange (crypto)
# "deriv" – use Deriv WebSocket API (forex / synthetics)
BROKER=deriv

# Data source for historical candles (defaults to BROKER value)
# "ccxt" | "deriv" | "mt5"
DATA_SOURCE=mt5

# ============================================================
# ccxt / generic crypto exchange (used when BROKER=ccxt)
# ============================================================
EXCHANGE=binance
API_KEY=your_ccxt_api_key
API_SECRET=your_ccxt_api_secret

# ============================================================
# Deriv API (https://app.deriv.com/account/api-token)
# ============================================================
DERIV_APP_ID=1089          # 1089 = Deriv demo app; register your own at https://developers.deriv.com
DERIV_TOKEN=your_deriv_api_token

# ============================================================
# MetaTrader 5 (Windows only – leave blank to skip)
# ============================================================
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=MetaQuotes-Demo

# ============================================================
# Trading mode
# ============================================================
TRADING_MODE=paper     # paper | live

# ============================================================
# Symbols – comma-separated list of forex pairs
# ============================================================
SYMBOLS=EUR/USD,GBP/USD,USD/JPY,AUD/USD
TIMEFRAME=1h

# ============================================================
# Strategy
# ============================================================
STRATEGY=sma_crossover
SMA_FAST=10
SMA_SLOW=30

# ============================================================
# Risk management
# ============================================================
MAX_POSITION_PCT=0.10     # max 10 % of portfolio per trade
STOP_LOSS_PCT=0.02        # 2 % stop-loss
TAKE_PROFIT_PCT=0.04      # 4 % take-profit
DERIV_MULTIPLIER=10       # leverage multiplier for Deriv contracts

# ============================================================
# Paper trading
# ============================================================
PAPER_BALANCE=10000
